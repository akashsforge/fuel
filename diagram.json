{
  "version": 1,
  "author": "Fuel Monitor Project",
  "editor": "wokwi",
  "serialMonitor": {"display": "always", "newline": "lf"},
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 100, "left": 300, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": 0, "left": 300, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-potentiometer", "id": "pot", "top": 300, "left": 0, "attrs": { "value": "50" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 420, "left": 0, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led1", "top": 420, "left": 550, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 420, "left": 460, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [] ],
    [ "oled1:SDA", "esp:D21", "blue", [] ],
    [ "oled1:SCL", "esp:D22", "green", [] ],
    [ "esp:3V3", "pot:VCC", "red", [] ],
    [ "esp:GND.2", "pot:GND", "black", [] ],
    [ "esp:D34", "pot:SIG", "yellow", [] ],
    [ "esp:D25", "btn:1.l", "orange", [] ],
    [ "esp:GND.3", "btn:2.l", "black", [] ],
    [ "esp:D2", "r1:1", "white", [] ],
    [ "r1:2", "led1:A", "white", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
